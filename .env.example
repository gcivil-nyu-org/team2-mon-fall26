# Generate a local .env with: python3 scripts/create_env.py
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DEMO_MODE=1
MYSQL_DATABASE=connectnyc
MYSQL_USER=connectnyc
MYSQL_PASSWORD=replace-with-a-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-password
MYSQL_HOST=db
MYSQL_PORT=3306
WEB_PORT=8000
